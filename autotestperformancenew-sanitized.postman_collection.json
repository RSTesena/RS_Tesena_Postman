      "name": "GetProducts",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "var productIds = [];\r",
              "\r",
              "var jsonData = pm.response.json();\r",
              "var data = jsonData.data;\r",
              "\r",
              "//console.log(data[0].ProductId)\r",
              "for (i=0; i<data.length; i++){\r",
              "    productIds.push(data[i].ProductId);\r",
              "}\r",
              "//console.log(productIds);\r",
              "\r",
              "const sanitizedId = \"sanitizedID-2131h321h-23112j-21312321kj-23112312oopp\";\r",
              "\r",
              "const jsonResponse = productIds.map((productId, index) => {\r",
              "  return {\r",
              "    LineId: (index + 3001).toString(),\r",
              "    ProductId: productId,\r",
              "    sanitizedId: sanitizedId\r",
              "  };\r",
              "});\r",
              "\r",
              "jsonItem = JSON.stringify(jsonResponse, null, 2);\r",
              "\r",
              "console.log(jsonItem);\r",
              "\r",
              "pm.collectionVariables.set(\"Items\", jsonItem);\r",
              "\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {}
          }
        }
